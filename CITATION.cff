      - family-names: "Li"
        given-names: "Huijun"
    year: 2025
    doi: "10.1109/CYBER67662.2025.11168313"
    collection-title: "Proc. 15th IEEE International Conference on CYBER Technology in Automation, Control, and Intelligent Systems (CYBER 2025)"
    notes: "Shanghai, China, 15-18 July 2025. IEEE Xplore document no. 11168313. Primary method reference for this re-implementation."

